{
  "name": "Payout",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "Driver user id requesting the payout"
    },
    "wallet_id": {
      "type": "string",
      "description": "Source wallet"
    },
    "amount": {
      "type": "number",
      "description": "Payout amount in USD"
    },
    "status": {
      "type": "string",
      "description": "Payout status",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "method": {
      "type": "string",
      "description": "Payout method (ecocash, onemoney, zipit, bank)"
    },
    "destination": {
      "type": "string",
      "description": "Payout destination reference (mobile number / account)"
    },
    "transaction_id": {
      "type": "string",
      "description": "Associated Transaction record"
    },
    "gateway_ref": {
      "type": "string",
      "description": "Gateway reference once a real payout provider is connected"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the payout was processed"
    }
  },
  "required": [
    "driver_id",
    "amount",
    "method"
  ],
  "security": {
    "read": "owner",
    "update": "owner",
    "delete": "admin",
    "list": "owner"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
