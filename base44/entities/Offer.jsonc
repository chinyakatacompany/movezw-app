{
  "name": "Offer",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "The transport request this offer is for"
    },
    "driver_id": {
      "type": "string",
      "description": "The User id of the driver"
    },
    "driver_profile_id": {
      "type": "string",
      "description": "The DriverProfile id of the driver"
    },
    "driver_name": {
      "type": "string",
      "description": "Driver display name"
    },
    "driver_photo_url": {
      "type": "string",
      "description": "Driver profile photo snapshot at time of offer"
    },
    "verified": {
      "type": "boolean",
      "description": "Whether the driver was admin-verified at time of offer",
      "default": false
    },
    "vehicle_type": {
      "type": "string",
      "description": "Vehicle type of the driver"
    },
    "driver_rating": {
      "type": "number",
      "description": "Driver average rating at time of offer"
    },
    "completed_jobs": {
      "type": "number",
      "description": "Driver completed deliveries count at time of offer",
      "default": 0
    },
    "eta_minutes": {
      "type": "number",
      "description": "Estimated arrival time at pickup in minutes"
    },
    "price": {
      "type": "number",
      "description": "Quoted price in USD"
    },
    "note": {
      "type": "string",
      "description": "Optional message from the driver"
    },
    "status": {
      "type": "string",
      "description": "Status of the offer",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "request_id",
    "driver_id",
    "price"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "owner",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
