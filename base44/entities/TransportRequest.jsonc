{
  "name": "TransportRequest",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Reference to the customer User"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer display name"
    },
    "pickup_location": {
      "type": "string",
      "description": "Pickup address / area"
    },
    "destination": {
      "type": "string",
      "description": "Drop-off address / area"
    },
    "cargo_type": {
      "type": "string",
      "description": "Category of goods being moved",
      "enum": [
        "Furniture",
        "Building Materials",
        "Groceries",
        "Farm Produce",
        "Parcels",
        "Other"
      ]
    },
    "cargo_weight": {
      "type": "string",
      "description": "Optional cargo weight description"
    },
    "cargo_description": {
      "type": "string",
      "description": "Free-text description of the cargo"
    },
    "photos": {
      "type": "array",
      "description": "Up to 5 photos of the cargo",
      "items": {
        "type": "string"
      },
      "maxItems": 5
    },
    "timing": {
      "type": "string",
      "description": "Whether transport is needed now or scheduled",
      "enum": [
        "now",
        "scheduled"
      ],
      "default": "now"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When transport is needed (if scheduled)"
    },
    "budget": {
      "type": "number",
      "description": "Customer's suggested budget in USD"
    },
    "status": {
      "type": "string",
      "description": "Current state of the transport request / delivery",
      "enum": [
        "open",
        "confirmed",
        "en_route_pickup",
        "collected",
        "in_transit",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "accepted_offer_id": {
      "type": "string",
      "description": "The offer accepted by the customer"
    },
    "accepted_driver_id": {
      "type": "string",
      "description": "The driver who was accepted"
    },
    "accepted_price": {
      "type": "number",
      "description": "The agreed price from the accepted offer"
    },
    "payment_status": {
      "type": "string",
      "description": "Future-ready payment status",
      "enum": [
        "pending",
        "paid",
        "cod"
      ],
      "default": "cod"
    },
    "payment_method": {
      "type": "string",
      "description": "Future-ready payment method (e.g. EcoCash, Stripe)"
    }
  },
  "required": [
    "customer_id",
    "pickup_location",
    "destination",
    "cargo_type",
    "timing",
    "budget"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "owner",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.accepted_driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
