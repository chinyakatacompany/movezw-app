{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "customer",
        "driver",
        "admin"
      ],
      "default": "customer"
    },
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "is_suspended": {
      "type": "boolean",
      "description": "Whether the user is suspended by admin",
      "default": false
    }
  },
  "required": [
    "role"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "admin",
    "list": "admin"
  }
}
