{
  "name": "CommissionConfig",
  "type": "object",
  "properties": {
    "rate": {
      "type": "number",
      "description": "Platform commission rate as a fraction (0-0.5)",
      "default": 0.1
    },
    "low_balance_threshold": {
      "type": "number",
      "description": "Wallet balance below this (USD) triggers a low-balance alert for drivers",
      "default": 5
    },
    "refund_after_loading_requires_approval": {
      "type": "boolean",
      "description": "If true, commission refunds for cancellations after cargo loading require admin approval",
      "default": true
    },
    "cancellation_policy_note": {
      "type": "string",
      "description": "Human-readable cancellation / refund policy"
    },
    "updated_by_id": {
      "type": "string",
      "description": "Admin who last updated the config"
    }
  },
  "required": [
    "rate"
  ],
  "security": {
    "read": "auth",
    "update": "admin",
    "delete": "admin",
    "list": "auth"
  }
}
