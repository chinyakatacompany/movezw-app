{
  "name": "RefundRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "The cancelled transport request"
    },
    "driver_id": {
      "type": "string",
      "description": "Driver whose commission refund is requested"
    },
    "wallet_id": {
      "type": "string",
      "description": "Driver wallet id"
    },
    "amount": {
      "type": "number",
      "description": "Refund amount in USD"
    },
    "reason": {
      "type": "string",
      "description": "Why the refund is requested"
    },
    "status": {
      "type": "string",
      "description": "Approval / claim status",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "pending"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "decided_by_id": {
      "type": "string",
      "description": "Admin who decided the request"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_note": {
      "type": "string",
      "description": "Admin decision note"
    }
  },
  "required": [
    "request_id",
    "driver_id",
    "amount",
    "reason"
  ],
  "security": {
    "read": "auth",
    "update": "auth",
    "delete": "admin",
    "list": "auth"
  }
}
