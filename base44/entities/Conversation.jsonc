{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "The transport request this conversation is tied to"
    },
    "request_label": {
      "type": "string",
      "description": "Human label, e.g. cargo type and route"
    },
    "customer_id": {
      "type": "string",
      "description": "The customer User id"
    },
    "driver_id": {
      "type": "string",
      "description": "The driver User id"
    },
    "driver_name": {
      "type": "string",
      "description": "Driver display name"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer display name"
    },
    "last_message": {
      "type": "string",
      "description": "Preview of the most recent message"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last message was sent"
    },
    "typing_user_id": {
      "type": "string",
      "description": "User id currently typing (if any)"
    },
    "typing_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last typing ping"
    }
  },
  "required": [
    "request_id",
    "customer_id",
    "driver_id"
  ],
  "security": {
    "read": "auth",
    "update": "auth",
    "delete": "admin",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "data.driver_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
