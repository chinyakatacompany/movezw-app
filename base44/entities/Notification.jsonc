{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user receiving the notification"
    },
    "type": {
      "type": "string",
      "description": "Notification category",
      "enum": [
        "new_offer",
        "offer_accepted",
        "offer_rejected",
        "status_update",
        "job_assigned",
        "rating_received",
        "verification",
        "admin"
      ]
    },
    "title": {
      "type": "string",
      "description": "Short notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification body text"
    },
    "link": {
      "type": "string",
      "description": "Optional route to navigate to when tapped"
    },
    "is_read": {
      "type": "boolean",
      "description": "Whether the notification has been read",
      "default": false
    }
  },
  "required": [
    "user_id",
    "title",
    "message"
  ],
  "security": {
    "read": "owner",
    "update": "owner",
    "delete": "owner",
    "list": "owner"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
