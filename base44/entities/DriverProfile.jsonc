{
  "name": "DriverProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the User account"
    },
    "business_id": {
      "type": "string",
      "description": "The Business account this driver belongs to (empty for independent drivers)"
    },
    "full_name": {
      "type": "string",
      "description": "Driver full name"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "national_id_url": {
      "type": "string",
      "description": "Uploaded National ID document"
    },
    "driver_licence_url": {
      "type": "string",
      "description": "Uploaded Driver's Licence document"
    },
    "vehicle_registration_url": {
      "type": "string",
      "description": "Uploaded Vehicle Registration document"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "Driver profile photo"
    },
    "vehicle_type": {
      "type": "string",
      "description": "Type of vehicle available for transport",
      "enum": [
        "Motorcycle",
        "Pickup",
        "1 Ton Truck",
        "3 Ton Truck",
        "5 Ton Truck",
        "10 Ton Truck",
        "Articulated Truck"
      ]
    },
    "verification_status": {
      "type": "string",
      "description": "Admin verification status of the driver",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "verification_note": {
      "type": "string",
      "description": "Admin note on verification decision"
    },
    "location_area": {
      "type": "string",
      "description": "Area/city where the driver usually operates"
    },
    "rating_avg": {
      "type": "number",
      "description": "Average star rating from completed jobs",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "description": "Total number of ratings received",
      "default": 0
    },
    "completed_jobs": {
      "type": "number",
      "description": "Total completed deliveries",
      "default": 0
    },
    "availability_status": {
      "type": "string",
      "description": "Driver availability for the intelligent job-matching system. Only 'online' drivers receive new matched job requests.",
      "enum": [
        "online",
        "busy",
        "offline"
      ],
      "default": "offline"
    },
    "latitude": {
      "type": "number",
      "description": "Driver current latitude (placeholder for future live GPS integration)"
    },
    "longitude": {
      "type": "number",
      "description": "Driver current longitude (placeholder for future live GPS integration)"
    },
    "last_available_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the driver last marked themselves available; used as a freshness/response-time signal in matching"
    }
  },
  "required": [
    "user_id",
    "full_name",
    "vehicle_type"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "admin",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
