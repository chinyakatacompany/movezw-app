{
  "name": "FleetVehicle",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "The Business account that owns this vehicle"
    },
    "vehicle_type": {
      "type": "string",
      "description": "Type of vehicle",
      "enum": [
        "Motorcycle",
        "Pickup",
        "1 Ton Truck",
        "3 Ton Truck",
        "5 Ton Truck",
        "10 Ton Truck",
        "Articulated Truck"
      ]
    },
    "plate_number": {
      "type": "string",
      "description": "Vehicle registration plate"
    },
    "model": {
      "type": "string",
      "description": "Vehicle make / model"
    },
    "year": {
      "type": "number",
      "description": "Vehicle model year"
    },
    "capacity_kg": {
      "type": "number",
      "description": "Maximum cargo capacity in kilograms"
    },
    "assigned_driver_profile_id": {
      "type": "string",
      "description": "DriverProfile id currently assigned to this vehicle"
    },
    "assigned_driver_name": {
      "type": "string",
      "description": "Snapshot name of the assigned driver"
    },
    "status": {
      "type": "string",
      "description": "Vehicle operational status",
      "enum": [
        "active",
        "in_maintenance",
        "retired"
      ],
      "default": "active"
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the vehicle was last serviced"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled next service date"
    },
    "odometer_km": {
      "type": "number",
      "description": "Current odometer reading in kilometres",
      "default": 0
    }
  },
  "required": [
    "business_id",
    "vehicle_type",
    "plate_number"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "admin",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
