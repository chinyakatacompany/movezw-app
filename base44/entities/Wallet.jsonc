{
  "name": "Wallet",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the wallet"
    },
    "balance": {
      "type": "number",
      "description": "Available balance in USD",
      "default": 0
    },
    "pending": {
      "type": "number",
      "description": "Pending / escrow balance in USD",
      "default": 0
    },
    "currency": {
      "type": "string",
      "description": "Wallet currency code",
      "default": "USD"
    },
    "total_earned": {
      "type": "number",
      "description": "Lifetime earnings (drivers)",
      "default": 0
    },
    "total_commission": {
      "type": "number",
      "description": "Lifetime platform commission paid",
      "default": 0
    },
    "total_paid_out": {
      "type": "number",
      "description": "Lifetime amount paid out",
      "default": 0
    }
  },
  "required": [
    "user_id"
  ],
  "security": {
    "read": "owner",
    "update": "owner",
    "delete": "admin",
    "list": "owner"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
