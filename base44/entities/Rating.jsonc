{
  "name": "Rating",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "The transport request being rated"
    },
    "customer_id": {
      "type": "string",
      "description": "The customer who left the rating"
    },
    "driver_id": {
      "type": "string",
      "description": "The driver receiving the rating"
    },
    "driver_profile_id": {
      "type": "string",
      "description": "The driver profile being rated"
    },
    "stars": {
      "type": "number",
      "description": "Star rating from 1 to 5",
      "minimum": 1,
      "maximum": 5
    },
    "comment": {
      "type": "string",
      "description": "Optional review comment"
    }
  },
  "required": [
    "request_id",
    "customer_id",
    "driver_id",
    "stars"
  ],
  "security": {
    "read": "auth",
    "update": "owner",
    "delete": "admin",
    "list": "auth"
  },
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.customer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
