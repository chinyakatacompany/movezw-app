{
  "name": "ReturnLoadBooking",
  "type": "object",
  "properties": {
    "return_load_id": {
      "type": "string",
      "description": "The ReturnLoad listing this booking is for"
    },
    "driver_id": {
      "type": "string",
      "description": "Driver User id who owns the listing (denormalized for queries)"
    },
    "customer_id": {
      "type": "string",
      "description": "Customer User id requesting space"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer display name"
    },
    "requested_capacity_kg": {
      "type": "number",
      "description": "Capacity requested in kilograms"
    },
    "offered_price": {
      "type": "number",
      "description": "Price offered by the customer in USD"
    },
    "cargo_description": {
      "type": "string",
      "description": "Description of the cargo to move"
    },
    "message": {
      "type": "string",
      "description": "Optional message to the driver"
    },
    "status": {
      "type": "string",
      "description": "Booking status",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "required": [
    "return_load_id",
    "customer_id",
    "customer_name",
    "requested_capacity_kg",
    "offered_price"
  ],
  "security": {
    "read": "auth",
    "update": "auth",
    "delete": "owner",
    "list": "auth"
  }
}
